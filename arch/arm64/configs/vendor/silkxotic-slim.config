#
# SilkXotic v1.1 "Charmeuse" — debug/overhead trim (roadmap 🥇 "Strip debug overhead").
# Layered AFTER silkxotic-opts.config. Goal: cut build cost with ZERO functional or
# measurement regression — a smoothness kernel must stay measurable.
#
# This is deliberately ONE variable (the roadmap's process: change one thing per build):
#   DEBUG_INFO — the dominant vmlinux bloat and link-time RAM cost on the 7.5 GB build
#                host. It lives in non-loadable ELF sections, so it barely changes the
#                stripped Image.gz; the real win is build memory + speed (which also
#                eases the Full-LTO aspiration). No runtime effect. Its sub-options
#                (BTF/DWARF4/SPLIT/REDUCED, GDB_SCRIPTS) cascade off with it.
CONFIG_DEBUG_INFO=n

#
# NOT stripped, and why the roadmap's broader list does NOT apply to this build (all
# verified against this exact tree):
#   FTRACE/TRACING — kept: it is Android atrace/Perfetto's tracing backend, needed to
#                    MEASURE jank & touch-latency (v1.1's measurement items). The only
#                    per-event hot-path tracer, FUNCTION_TRACER, is ALREADY off, so the
#                    "costs cycles every event" rationale doesn't apply here.
#   STACKTRACE     — NOT droppable: TRACING select's it (kernel/trace/Kconfig). It rides
#                    along with the tracing backend we keep; olddefconfig forces it on.
#   SCHED_DEBUG    — kept: exposes the /proc/sys/kernel/sched_* knobs the EAS/stune A/B
#                    tunes (kernel/sysctl.c #ifdef CONFIG_SCHED_DEBUG).
#   DEBUG_KERNEL   — kept: cheap gate SCHED_DEBUG depends on (DEBUG_KERNEL && PROC_FS).
#   KSU/SUSFS need none of the above (manual hooks; KPROBES is off).
