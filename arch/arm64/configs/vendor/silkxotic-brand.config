#
# SilkXotic branding — kernel identity (uname). Merge LAST.
# Changes the kernel release string to 4.14.357-silkxotic.
# NOTE: this alters vermagic, so the (unused) IR module built for "-perf" won't load.
# SUSFS uname-spoofing (CONFIG_KSU_SUSFS_SPOOF_UNAME=y) can present a stock uname to
# integrity-sensitive apps independently of this.
#
CONFIG_LOCALVERSION="-silkxotic"
# CONFIG_LOCALVERSION_AUTO is not set
