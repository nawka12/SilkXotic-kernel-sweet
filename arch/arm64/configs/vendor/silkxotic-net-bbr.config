#
# SilkXotic v1.1 "Charmeuse" — TCP BBR + fq qdisc (roadmap 🥇). Pure config, no source patch.
# Layered after silkxotic-opts.config.
#
# BBR + fq is a cheap latency/throughput win on mobile links. We bake BOTH defaults in:
#   TCP_CONG_ADVANCED — gate that exposes the per-algo options + the default choice.
#   TCP_CONG_BBR      — build BBR (net/ipv4/tcp_bbr.c is present in-tree).
#   DEFAULT_BBR       — sets CONFIG_DEFAULT_TCP_CONG="bbr".
#   TCP_CONG_CUBIC    — kept as the fallback algorithm.
#   NET_SCH_FQ        — build the fq qdisc (BBR pairs best with fq's pacing).
#   NET_SCH_DEFAULT + DEFAULT_FQ — set net.core.default_qdisc default to "fq" at boot.
#       This tree HAS the compile-time selector (net/sched/Kconfig), so no init.d sysctl
#       is needed; without it BBR still works via TCP's internal pacing, just less ideal.
#
# CAVEAT (verify on-device): userspace/init can still override via sysctl. Confirm:
#   sysctl net.ipv4.tcp_congestion_control            -> want: bbr
#   sysctl net.core.default_qdisc                     -> want: fq
#   sysctl net.ipv4.tcp_available_congestion_control  -> must list bbr
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y

# TCP_CONG_ADVANCED unlocks BIC/HTCP/WESTWOOD as =m by default. SilkXotic ships only
# Image.gz (no modules), and we use bbr, so pin them off — the net change is exactly
# "BBR built-in + CUBIC fallback", nothing stray built.
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_TCP_CONG_WESTWOOD is not set

CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
