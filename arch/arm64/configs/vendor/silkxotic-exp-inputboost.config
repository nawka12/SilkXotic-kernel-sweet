#
# SilkXotic EXPERIMENT (not in the default merge list) — arm the touch boost the ROM
# never arms. Build with:
#
#   EXTRA_CONFIGS=arch/arm64/configs/vendor/silkxotic-exp-inputboost.config \
#     OUT=out-exp ./silkxotic/build-silkxotic.sh
#
# Littles to 1.248 GHz: the same floor the Power HAL sets during INTERACTION, but
# applied from the first evdev event instead of after a binder hop into the HAL.
# Golds to 1.3248 GHz: the HAL never floors the golds on touch at all.
#
# Duration is the driver's own default (40 ms) with a 150 ms minimum interval between
# boosts, so the cost is bounded by construction and needs no battery A/B.
#
# Ship this in the release config only if the A/B shows a real ramp-time win on cpu6.
#
CONFIG_CPU_BOOST_INPUT_FREQ_DEFAULT="0:1248000 6:1324800"
