#
# Safe BruthXotic-derived optimizations (config-visible subset)
# Layered ON TOP of vendor/sdmsteppe-perf_defconfig + vendor/sweet.config.
# Every symbol below was verified to exist in this exact tree (no silent no-ops).
# Keeps LTO on, HZ=300, KSU/SUSFS, and crDroid's dtb/dtbo untouched.
#
# NOTE: SPECULATIVE_PAGE_FAULT is intentionally NOT here — it does not exist as a
# Kconfig symbol in this tree (BruthXotic backported it in source). Adding it would
# be a no-op; a real backport is a separate, higher-risk task.

# QTI dynamic CPU/input boost (touch-to-render latency)
CONFIG_CPU_BOOST=y

# QTI core control — smarter online/offline of the gold cluster under load
CONFIG_SCHED_CORE_CTL=y

# QTI perf module — exposes cpufreq min/max hints for perfd/power-HAL
CONFIG_MSM_PERFORMANCE=y

# Per-session scheduler autogrouping — favors the foreground app
CONFIG_SCHED_AUTOGROUP=y

# Reclaim balancing tweak
CONFIG_BALANCE_ANON_FILE_RECLAIM=y

# SLUB per-CPU partial lists — allocator throughput
CONFIG_SLUB_CPU_PARTIAL=y
